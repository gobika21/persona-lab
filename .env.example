# Copy to .env

# Claude API key for the persona agents (and evals)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model (default claude-opus-5-5) and effort (low | medium | high | xhigh | max, default medium).
# Change them and re-run evals to compare quality and cost.
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Optional: prices per million tokens. Claude Opus 5.5 prices are built in (personalab/pricing.py);
# set these for another model or if prices change.
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=
# PRICE_CACHE_READ_PER_MTOK=     # defaults to 0.1 x input
# PRICE_CACHE_WRITE_PER_MTOK=    # defaults to 1.25 x input

# ---- Public hosting ----
# PUBLIC_MODE=1             # block internal URLs, free daily allowance per visitor
# TRUST_PROXY=1             # read visitor IP from X-Forwarded-For (Render, Fly, Railway…)
# LIMIT_JOURNEY=12          # per visitor per day; one run uses 4 (one per persona)
# LIMIT_SITE_JOURNEY=40     # all visitors together per day on your key (caps your bill); own-key runs don't count
# MAX_CONCURRENT_BROWSERS=8
