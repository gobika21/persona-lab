{
  "version": 1,
  "notes": "Planted barriers and known task outcomes for the Persona Lab benchmark. 'possible' is whether the task can be completed by that persona with the tools the simulation gives them. A finding matches a barrier when its title+detail contain one of the barrier's 'anchors' AND one of its 'kinds' (case-insensitive), and it came from a persona listed in 'personas'.",
  "personas": [
    "keyboard",
    "screen_reader",
    "color_blind",
    "low_vision"
  ],
  "tasks": [
    {
      "id": "hotel-phone",
      "site": "hotel",
      "start": "index.html",
      "goal": "Find the hotel's phone number",
      "success": {
        "answer_contains": [
          "555 0123",
          "5550123"
        ]
      },
      "possible": {
        "keyboard": true,
        "screen_reader": true,
        "color_blind": true,
        "low_vision": true
      }
    },
    {
      "id": "hotel-book",
      "site": "hotel",
      "start": "index.html",
      "goal": "Start booking a room using the 'Book a room' button on the home page",
      "success": {
        "url_contains": [
          "booking=1"
        ]
      },
      "possible": {
        "keyboard": false,
        "screen_reader": true,
        "color_blind": true,
        "low_vision": true
      }
    },
    {
      "id": "shop-green-mug",
      "site": "shop",
      "start": "index.html",
      "goal": "Add the green mug to the cart",
      "success": {
        "url_contains": [
          "item=green"
        ]
      },
      "possible": {
        "keyboard": true,
        "screen_reader": false,
        "color_blind": false,
        "low_vision": true
      }
    },
    {
      "id": "clinic-book",
      "site": "clinic",
      "start": "index.html",
      "goal": "Book an appointment for any day next week (name: Sara Ahmed, mobile: 050 123 4567)",
      "success": {
        "url_contains": [
          "confirmed.html"
        ]
      },
      "possible": {
        "keyboard": false,
        "screen_reader": true,
        "color_blind": true,
        "low_vision": true
      }
    },
    {
      "id": "library-hours",
      "site": "library",
      "start": "index.html",
      "goal": "Find what time the library opens on Saturday",
      "success": {
        "answer_contains": [
          "10:00",
          "10 am",
          "10am",
          "10 a.m"
        ]
      },
      "possible": {
        "keyboard": true,
        "screen_reader": true,
        "color_blind": true,
        "low_vision": true
      }
    }
  ],
